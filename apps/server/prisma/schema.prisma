// ============================================================
// AI Clip Studio - Database Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// ============================================================
// User
// ============================================================

enum UserRole {
  user
  admin
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  avatar    String?
  role      UserRole @default(user)

  // Relations
  media       Media[]
  projects    Project[]
  templates   Template[]
  renderTasks RenderTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Media (缂傚倷娴囨禍顒佹叏闂堟侗鐒?
// ============================================================

enum MediaType {
  video
  image
  audio
}

enum ProcessingStatus {
  pending
  processing
  completed
  failed
}

model Media {
  id           String   @id @default(uuid())
  userId       String
  type         MediaType
  filename     String
  originalName String
  mimeType     String
  size         Int
  duration     Float?
  width        Int?
  height       Int?
  thumbnailPath String?
  filePath     String
  status       ProcessingStatus @default(pending)

  // Relations
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags    MediaTag[]
  analysis MediaAnalysis?
  scenes  Scene[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, type])
}

model MediaTag {
  id            String @id @default(uuid())
  mediaId       String
  name          String
  category      String // character | technique | emotion | scene | custom
  confidence    Float  @default(1.0)
  isAutoGenerated Boolean @default(false)

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@index([name, category])
}

model MediaAnalysis {
  id                 String   @id @default(uuid())
  mediaId            String   @unique
  sceneDescription   String?
  transcription      String?
  keyframeDescriptions String[]
  colorPalette       String[]
  motionIntensity    Float?
  sentiment          String?
  createdAt          DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

// ============================================================
// Project (闂備礁鎲￠幖鈺傜閿濆洦顐芥い鎰剁祷娴滄粓鏌涢敂璇插箺缂?
// ============================================================

enum ClipStyle {
  fast_paced
  slow
  beat_sync
}

model Project {
  id             String   @id @default(uuid())
  userId         String
  name           String
  description    String?
  script         String?  // 闂佽崵鍠愰悷杈╃礊閳ь剚銇勯弴妤佹珚鐎殿噮鍓熷畷鍫曗€﹂幋鐐存殼
  clipStyle      ClipStyle @default(fast_paced)
  targetDuration Int?
  templateId     String?
  templateMode   String? // strict | reference
  thumbnailPath  String?
  status         ProcessingStatus @default(pending)

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenes      Scene[]
  renderTasks RenderTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Scene {
  id           String  @id @default(uuid())
  projectId    String
  mediaId      String?
  order        Int
  startTime    Float?
  endTime      Float?
  caption      String? // 闂佽瀛╃粙鎺椼€冮崨顖滀笉闁绘垼妫勫Λ姗€鏌涢妷锝呭闁?  transition   String? @default("cut")
  transitionDuration Float?
  duration     Float
  sourceText   String? // 闂佽娴烽弫鎼佸箠閹炬儼濮抽柡灞诲劜閸庡秹鏌涢弴銊ユ殨闁圭儤姊圭€氭氨鐥幆褜鍎戞俊?  matchScore   Float?  // AI闂備礁鎲￠悧鏇犵礊婵犲洤鍌ㄩ柕鍫濐槸缁€鍡涙煕閳╁叐鎴濃枔?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([projectId, order])
}

// ============================================================
// Template (婵犵妲呴崹顏堝礈濠靛棭鐔?
// ============================================================

model Template {
  id          String   @id @default(uuid())
  userId      String?
  name        String
  description String?
  isBuiltIn   Boolean  @default(false)
  thumbnailPath String?

  user     User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis TemplateAnalysis?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isBuiltIn])
}

model TemplateAnalysis {
  id                  String @id @default(uuid())
  templateId          String @unique
  averageShotDuration Float
  shotDurationDistribution Float[]
  transitionCounts    Json?
  commonTransitions   String[]
  beatSyncPattern     Float[]
  pacingScore         Float
  styleTags           String[]

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

// ============================================================
// Render Task (婵犵數鍋為幐绋款嚕閸洘鍋傞悗锝庡亞椤╃兘鎮归崶銊ョ祷妞?
// ============================================================

model RenderTask {
  id              String   @id @default(uuid())
  projectId       String
  userId          String
  status          ProcessingStatus @default(pending)
  progress        Int      @default(0)
  outputFormat    String   @default("mp4")
  outputResolution String   @default("1920x1080")
  outputPath      String?
  shareLink       String?
  error           String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([projectId])
  @@index([status])
}