{
  "name": "ai-clip-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:web": "pnpm --filter @ai-clip/web run dev",
    "dev:server": "pnpm --filter @ai-clip/server run dev",
    "build": "pnpm --parallel -r run build",
    "build:shared": "pnpm --filter @ai-clip/shared run build",
    "build:web": "pnpm --filter @ai-clip/web run build",
    "build:server": "pnpm --filter @ai-clip/server run build",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\""
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}