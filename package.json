{
  "name": "anicut-studio",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm --parallel -r run build",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "deploy:build": "cd apps/server && npx prisma generate && npx nest build",
    "deploy:start": "node apps/server/dist/apps/server/src/main.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}